# Copie este archivo como .env y ajuste los valores.

# Conexión a PostgreSQL (local, Docker o en la nube: Neon, Supabase, Render, Railway...)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parqueadero
# Ponga true si su proveedor en la nube exige SSL (Neon / Supabase / Render)
DATABASE_SSL=false

PORT=3000
# Secreto para firmar los tokens de sesión. Use una cadena larga y aleatoria.
JWT_SECRET=cambie-este-secreto-por-uno-largo
JWT_EXPIRES_HOURS=12

# Respaldo automático (RF20)
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=30

# Intentos fallidos antes de bloquear un usuario (RF18)
MAX_FAILED_LOGINS=5

# Clave para cámaras lectoras de placas (POST /movements/reader con header X-Device-Key)
PLATE_READER_KEY=

# Rango de números de casa del conjunto
HOUSE_MIN=1
HOUSE_MAX=300
