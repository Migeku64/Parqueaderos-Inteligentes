{
  "name": "parqueadero-comunitario-api",
  "version": "1.0.0",
  "description": "API REST + WebSocket del sistema de gestión de parqueaderos comunitarios (Nueva Castilla Etapa 3)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/migrate.js --reset && node scripts/seed.js",
    "test": "node --test --test-concurrency=1 test/api.test.js"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  },
  "license": "MIT"
}
